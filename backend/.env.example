# Base de datos (PostgreSQL / Supabase)
DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# Auth (JWT)
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Supabase Storage (documentos e imagenes)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=change-me

# CORS
FRONTEND_URL=http://localhost:5173

# "development" o "production" - determina las flags de las cookies de auth
# (ver app/core/cookies.py). En Render, poner ENVIRONMENT=production.
ENVIRONMENT=development
